<div data-bind="with: settings.plugins.cloudflare_access_sso">
  <div class="control-group">
    <label class="control-label" for="cf_team_domain">Team Domain</label>
    <div class="controls">
      <input
        type="text"
        id="cf_team_domain"
        class="input-block-level"
        data-bind="value: team_domain"
        placeholder="example.cloudflareaccess.com"
      />
      <span class="help-block">
        Your Cloudflare Zero Trust team domain, e.g.
        <code>example.cloudflareaccess.com</code>.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label" for="cf_audience">Audience (AUD)</label>
    <div class="controls">
      <input
        type="text"
        id="cf_audience"
        class="input-block-level"
        data-bind="value: audience"
        placeholder="Cloudflare Access application AUD tag"
      />
      <span class="help-block">
        The Audience (AUD) tag of your Cloudflare Access application. You can
        find this in
        <strong>Zero Trust → Access → Applications → [Application] → Overview</strong>.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label" for="cf_role_groups">Roles to groups</label>
    <div class="controls">
      <textarea
        id="cf_role_groups"
        class="input-block-level"
        rows="3"
        data-bind="value: role_groups"
        placeholder="admin: admins"
      ></textarea>
      <span class="help-block">
        One <code>role: group</code> per line. Each sign-in sets the user's
        groups from the <code>roles</code> claim your identity provider sends
        through Cloudflare Access (add <code>roles</code> under OIDC claims in
        the Cloudflare identity provider). Roles not listed here give no group.
        Use group keys such as <code>admins</code>, <code>users</code>,
        <code>readonly</code> or <code>guests</code>. Leave empty to manage
        groups in OctoPrint instead.
      </span>
    </div>
  </div>

  <div class="control-group">
    <div class="controls">
      <label class="checkbox" for="cf_local_autologin">
        <input type="checkbox" id="cf_local_autologin" data-bind="checked: local_autologin" />
        Sign in local connections without a Cloudflare token
      </label>
      <span class="help-block">
        A visitor from the lab without a Cloudflare Access token is signed in
        as an existing OctoPrint user: through the tunnel when their address
        (<code>X-Forwarded-For</code>) is the printer's own public IP, or
        directly when they're on one of the printer's own networks (by its
        local IP, or on the printer itself). Checked every 5 minutes. Visitors
        with a token still sign in as themselves. Logging out turns it off for that browser
        until the next manual sign-in.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label" for="cf_local_autologin_as">Local user</label>
    <div class="controls">
      <input
        type="text"
        id="cf_local_autologin_as"
        class="input-block-level"
        data-bind="value: local_autologin_as, enable: local_autologin"
        placeholder="An existing OctoPrint username"
      />
    </div>
  </div>

  <div class="control-group">
    <label class="control-label" for="cf_allowed_cidrs">Allowed CIDR ranges</label>
    <div class="controls">
      <textarea
        id="cf_allowed_cidrs"
        class="input-block-level"
        rows="3"
        data-bind="value: allowed_cidrs"
        placeholder="e.g. 10.0.0.0/8, 192.168.0.0/16"
      ></textarea>
      <span class="help-block">
        Optional list of CIDR ranges from which requests are allowed for SSO, in
        addition to localhost. You may separate entries with commas, spaces or
        new lines.
      </span>
    </div>
  </div>

  <div class="control-group">
    <div class="controls">
      <label class="checkbox" for="cf_allow_cloudflare_ips">
        <input
          type="checkbox"
          id="cf_allow_cloudflare_ips"
          data-bind="checked: allow_cloudflare_ips"
        />
        Allow Cloudflare IP ranges
      </label>
      <span class="help-block">
        When enabled, the plugin fetches Cloudflare's official IPv4 and IPv6
        ranges at startup and allows SSO for requests originating from those
        networks.
      </span>
    </div>
  </div>
</div>
